# Copy to .env (or export these variables). Everything is optional except where noted.

# Storage. Without these, data is kept in data/items.parquet on your own computer.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # pipeline (write access). Keep secret!
SUPABASE_KEY=                     # dashboard (the public "anon" key, read-only)

# Bluesky search (free account -> Settings -> Privacy and security -> App passwords)
BSKY_HANDLE=yourname.bsky.social
BSKY_APP_PASSWORD=

# Sentiment: local model (default when transformers+torch are installed), or the free HF API
HUGGINGFACE_API_KEY=
# SENTIMENT_BACKEND=local|api|lexicon
# SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Optional X scraper (your own login cookies; use at your own risk)
X_AUTH_TOKEN=
X_CT0=
